# Production Environment Configuration (.env.prod)
# Copy this file to .env.prod and fill in your production values
# Source this file when deploying: source .env.prod && docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d

# ==================== Database ====================
# For production, use AWS RDS or managed database service
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@your-rds-endpoint.amazonaws.com:5432/incentive_db

# ==================== Application ====================
ENVIRONMENT=production
SECRET_KEY=your-secure-secret-key-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==================== CORS ====================
# Frontend domain for CORS
VITE_API_URL=https://your-domain.com/api

# ==================== Logging ====================
LOG_LEVEL=info

# ==================== Security ====================
# Set to true in production
SECURE_COOKIES=true
HTTPS_ONLY=true
